# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
.coverage
coverage.xml
htmlcov/
.pytest_cache/

# Virtual environments
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Conda environment folder if created inside the repo (it's recommended
# manter apenas environment.yml no repositório em vez do ambiente em si)
conda-env/

# Keep your environment file (environment.yml / environment.yaml) -
# não ignore esses arquivos pois descrevem o ambiente reproducível.

# Streamlit: evitar comitar segredos
.streamlit/secrets.toml
.streamlit/credentials.toml
.streamlit/config.toml
.streamlit/*.lock

# dotenv (contém variáveis de ambiente / chaves)
.env
.env.*

# OpenAI / chaves ou arquivos de credenciais locais
# (adicione nomes específicos se você usa arquivos customizados)
openai_api_key
*.key

# IDEs / editores
.idea/
.vscode/
*.iml

# Jupyter
.ipynb_checkpoints

# Logs
logs/
*.log

# Mypy / caches
.mypy_cache/

# PyInstaller
*.manifest
*.spec

# Sphinx build
docs/_build/

# OS files
.DS_Store
Thumbs.db

# Misc
__pypackages__/
*.egg
*.eggs

